.agency-admin-route
  padding 30px 0
  .agency-admin-container
    max-width 1500px
    margin 0 auto
  .agency-admin-controls
    display flex
    justify-content space-between
    align-items flex-end
    flex-wrap wrap
    gap 20px
    margin-bottom 20px
    h1
      margin-bottom 0
      margin-top 0
  #agency-admin-search
    width 350px
    max-width 100%
    margin-bottom 0
  .agency-admin-summary
    display grid
    grid-template-columns repeat(3, minmax(0, 1fr))
    gap 15px
    margin-bottom 25px
  .agency-admin-summary-card
    position relative
    display flex
    align-items center
    gap 15px
    min-height 120px
    padding 20px
    overflow hidden
    background #f9f9f9
    border 1px solid vs-lightgrey
    border-radius 15px
    box-shadow 0 3px 8px rgba(0,0,0,0.08)
    .summary-icon
      display inline-flex
      align-items center
      justify-content center
      flex 0 0 54px
      width 54px
      height 54px
      color vs-orange
      background #fff0ec
      border-radius 50%
      font-size 2.4rem
    .summary-content
      display flex
      flex-direction column
      min-width 0
      strong
        color vs-grey
        font-size 3.4rem
        line-height 1
      span
        margin-top 5px
        color vs-grey
        font-size 1.5rem
        font-weight 600
        line-height 1.2
      small
        margin-top 4px
        color vs-silver
        font-size 1.1rem
    &.tone-success
      .summary-icon
        color vs-green
        background #edf8ef
    &.tone-alert
      .summary-icon
        color vs-red
        background #fff0f2
  .agency-admin-jump-links
    display flex
    flex-wrap wrap
    gap 10px
    margin-bottom 30px
    button
      display inline-flex
      align-items center
      gap 7px
      width auto
      margin 0
      padding 8px 14px
      color vs-grey
      background white
      border 1px solid vs-lightgrey
      border-radius 20px
      font-weight 600
      box-shadow 0 2px 5px rgba(0,0,0,0.05)
      transition background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease
      &:hover, &.active
        color white
        background vs-orange
        border-color vs-orange
      &.active
        box-shadow 0 3px 8px rgba(241,91,37,0.25)
  .agency-admin-section
    margin-bottom 30px
    scroll-margin-top 120px
  .agency-admin-heading
    margin-bottom 10px
    h2
      margin 0
      margin-bottom 10px
  .agency-admin-table-controls
    display flex
    align-items center
    justify-content space-between
    gap 15px
    width 100%
    > span
      font-size 1.2rem
      white-space nowrap
  .agency-admin-control-row
    display flex
    align-items center
    flex-wrap wrap
    gap 15px
    label
      display inline-flex
      align-items center
      gap 7px
      margin 0
    select
      width auto
      min-width 70px
      margin-bottom 0
      padding 6px 30px 6px 10px
  .agency-admin-sort
    display inline-flex
    align-items center
    gap 7px
    span
      font-weight 600
    button
      width auto
      min-height 34px
      margin 0
      padding 6px 12px
      color vs-grey
      background white
      border 1px solid vs-lightgrey
      border-radius 18px
      font-size 1.2rem
      line-height 1
      transition background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease
      &:hover
        color vs-orange
        background #fff0ec
        border-color #ffd6c7
      &.selected
        color white
        background vs-orange
        border-color vs-orange
      i
        margin-left 5px
  .agency-admin-table-wrapper
    overflow-x auto
    background white
    border-radius 15px
    border 1px solid vs-lightgrey
    box-shadow 0 3px 8px rgba(0,0,0,0.08)
  .agency-admin-table
    width 100%
    table-layout fixed
    border-collapse separate
    border-spacing 0
    font-size 1.2rem
    padding 15px
    col.property-column
      width 210px
    col.fee-column
      width 75px
    col.date-column
      width 95px
    col.progress-column
      width 135px
    col.valuer-column
      width 70px
    th, td
      padding 9px 8px
      text-align center
      vertical-align middle
    thead th
      background #f4f5f7
      font-size 1.4rem
      line-height 1.2
      font-weight 600
      vertical-align bottom
    thead tr:first-child
      th:last-child
        border-top-right-radius 10px
    tbody tr:nth-child(even)
      background #f8f9fa
    tbody tr:hover
      background #fff5ed
    .admin-property
      min-width 170px
      text-align left
      border-top-left-radius 10px
      a
        color vs-grey
        font-size 1.35rem
        &:hover
          color vs-orange
    .admin-fee
      white-space nowrap
      span
        display inline-block
        padding 2px 6px
        border-radius 5px
        color vs-orange
        background #fff0e8
        font-weight 600
    .admin-date
      white-space nowrap
      font-weight 600
    .group-start, .admin-group
      border-left 1px solid #e8e8ed
    .admin-group
      font-size 1.4rem
      i
        margin-right 5px
    .group-end
      border-right 1px solid #e8e8ed
    .group-end + .group-start
      border-left 0
    .group-available
      background #fff0ec
      color vs-orange
    .group-sstc
      background #f2edfc
      color #5b408c
    .group-reduced
      background #e6f7ff
      color #0c4a6e
    .group-fall-through
      background #fcecf4
      color #8d2f63
  .admin-status-dot
    display inline-flex
    align-items center
    justify-content center
    vertical-align middle
    width 15px
    height 15px
    border-radius 50%
    &.status-completed
      background vs-green
    &.status-pending
      background vs-silver
    &.status-required
      background vs-red
    &.status-unavailable
      background white
      border 1px solid #777
      color #555
      font-weight 700
      line-height 1
  .admin-progress-meter
    display grid
    grid-template-columns 75px minmax(35px, 1fr)
    align-items center
    column-gap 8px
    strong
      min-width 35px
      text-align right
  .admin-progress-track
    width 75px
    height 7px
    background #e4e6ea
    border-radius 5px
    overflow hidden
  .admin-progress-fill
    height 100%
    background vs-orange
    border-radius 5px
  .admin-valuer
    img
      width 36px
      height 36px
      border-radius 50%
      border 1px solid vs-lightgrey
  .agency-admin-legend
    display flex
    flex-wrap wrap
    gap 15px
    margin-top 12px
    font-size 1.5rem
    > span
      display inline-flex
      align-items center
    .admin-status-dot
      margin-right 5px
  .agency-admin-pagination.pagination
    display flex
    align-items center
    justify-content center
    gap 6px
    width fit-content
    margin 18px auto 0
    padding 7px
    background white
    border 1px solid vs-lightgrey
    border-radius 30px
    box-shadow 0 3px 8px rgba(0,0,0,0.08)
    .page
      display inline-flex
      align-items center
      justify-content center
      min-width 34px
      height 34px
      padding 0 10px !important
      color vs-grey
      background transparent
      border 1px solid transparent
      border-radius 20px
      font-weight 600
      line-height 1
      transition background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease
      &:hover:not(.disabled)
        color vs-orange
        background #fff0ec
        border-color #ffd6c7
      &.selected
        color white
        background vs-orange
        border-color vs-orange
      &.disabled
        color vs-silver
        opacity 0.45
      &.firstNumber, &.last
        min-width 52px
      &.prev, &.next
        color vs-orange
        font-size 0
        &:before
          font-size 2rem
          font-weight 400
      &.prev:before
        content '‹'
      &.next:before
        content '›'

.agency-admin-tooltip
  --bs-tooltip-bg: #4b565f
  --bs-tooltip-color: white
  --bs-tooltip-opacity: 1
  --bs-tooltip-max-width: 280px
  .tooltip-inner
    padding 8px 12px
    border-radius 8px
    box-shadow 0 3px 8px rgba(0,0,0,0.2)

@media (max-width: 767px)
  .agency-admin-route
    .agency-admin-controls
      align-items stretch
      flex-direction column
    .agency-admin-table-controls
      align-items flex-start
      flex-direction column
    .agency-admin-control-row
      align-items flex-start
      flex-direction column
    .agency-admin-sort
      flex-wrap wrap
    .agency-admin-search
      width 100%
    .agency-admin-summary
      grid-template-columns 1fr
    .agency-admin-pagination.pagination
      flex-wrap wrap
      border-radius 15px
      .firstNumber, .last
        display none
