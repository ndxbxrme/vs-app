@import 'variables'

html
  font-size 62.5%
  overflow-y scroll

body
  color vs-text
  font-size 1.6rem
  line-height 2.4rem
  font-family proxima-nova, sans-serif
  background vs-body
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  &.login
    background vs-grey
  sub
    bottom 0px
.main-view
  flex 1

.orange
  color vs-orange
.grey
  color vs-grey
.error
  color red
  border 1px solid red
  padding 0 5px
  border-radius 5px

chain-box()
  width 100%
  border 1px solid vs-lightgrey
  border-radius 30px
  padding 15px
  background vs-white
  display flex
  align-items center
  img
    border-radius 20px
    margin-right 20px
  .address,
  .price
    font-size 1.8rem
    font-weight 600
    color vs-grey
  .price
    color vs-orange

.drop-box
  border 1px solis vs-grey
  border-radius 30px
  background vs-white
  width 100%
  text-align center
  margin 0px 0 10px
  padding 20px
  &.dragover
    h3
      color vs-orange
.document
  border 1px solid vs-lightgrey
  border-radius 3px
  background white
  padding 20px
  margin 0px 0px 10px 0px
  font-weight 600
  label
    font-weight 500
  svg
    font-size 5rem
  .controls
    margin-top 10px
.container-xl
  padding 0 30px

.snapshot
  margin-top 0px
  margin-bottom 30px
  .snapshot-item
    position relative
    display grid
    grid-template-columns 54px minmax(0, 1fr)
    grid-template-areas "icon value" "icon label"
    column-gap 15px
    align-content center
    min-height 120px
    padding 20px
    color vs-grey
    background #f9f9f9
    border 1px solid vs-lightgrey
    border-radius 20px
    box-shadow 0 3px 8px rgba(0,0,0,0.08)
    text-decoration none
    transition all .3s ease
    cursor default
    .snapshot-icon
      grid-area icon
      display inline-flex
      align-items center
      justify-content center
      align-self center
      width 54px
      height 54px
      color vs-orange
      background #fff0ec
      border-radius 50%
      font-size 2.4rem
      i
        position static
        color inherit
        font-size inherit
    .snapshot-value
      grid-area value
      align-self end
      color vs-grey
      font-size 3.4rem
      font-weight 600
      line-height 1
      &.currency
        text-align left
    .snapshot-label
      grid-area label
      align-self start
      margin-top 5px
      color vs-grey
      font-size 1.5rem
      font-weight 600
      line-height 1.2
      a
        color inherit
        text-decoration none
    &.snapshot-action
      padding-right 64px
      cursor pointer
      &:hover,
      &:focus-visible
        color vs-grey
        border-color rgba(255,87,34,0.4)
        box-shadow 0 6px 16px rgba(0,0,0,0.12)
        transform translateY(-2px)
        .snapshot-arrow
          color white
          background vs-orange
          transform translateX(2px)
      &:focus-visible
        outline 3px solid rgba(255,87,34,0.22)
        outline-offset 3px
    .snapshot-arrow
      position absolute
      top 15px
      right 15px
      display inline-flex
      align-items center
      justify-content center
      width 34px
      height 34px
      color vs-orange
      background white
      border 1px solid vs-lightgrey
      border-radius 50%
      font-size 1.3rem
      transition all .2s ease

[data-tooltip]
  position relative
  cursor pointer
  &:hover::before,
  &:hover::after
    opacity 1
    visibility visible
  &::before
    content attr(data-tooltip)
    position absolute
    top 50%
    left 50%
    transform translate(-50%, -50%)
    padding 8px 12px
    background rgba(0, 0, 0, 0.9)
    color white
    font-size 13px
    line-height 1.4
    border-radius 6px
    white-space nowrap
    opacity 0
    visibility hidden
    transition opacity 0.2s, visibility 0.2s
    pointer-events none
    z-index 10000
  &::after
    content ''
    position absolute
    bottom 0px
    left 50%
    transform translateX(-50%)
    border 6px solid transparent
    border-top-color rgba(0, 0, 0, 0.9)
    opacity 0
    visibility hidden
    transition opacity 0.2s, visibility 0.2s
    pointer-events none
    z-index 10000
@media screen and (max-width:576px)
  .main-view
    padding-top 90px