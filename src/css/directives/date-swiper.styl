@import '../global/variables'

$dark = #23292c
$darker = mix($dark, black, 50%)
$light = #e2e4e6
$lighter = mix($light, white, 40%)
$base = vs-orange
$alert = #f06292
// structural/functional
.date-swiper-holder
  z-index 10000001
  display flex
  align-items center
  justify-content center
  position fixed
  top 0
  left 0
  right 0
  bottom 0
  background rgba(0,0,0,0.3)
  transform: translate3d(-100%, 0%, 0)
  transition: transform 300ms ease-out
  &.is-active
    transform: translate3d(0%, 0%, 0)
  .date-swiper-box
    max-width 36rem
    position relative
    backdrop-filter blur(8px)
    -webkit-backdrop-filter blur(8px)
    .date-swiper-close
      position absolute
      top 1rem
      right 1rem
      width 2.8rem
      height 2.8rem
      border-radius 50%
      background rgba(255,255,255,0.15)
      color #fff
      font-size 2rem
      line-height 2.8rem
      text-align center
      cursor pointer
      z-index 10
      &:hover
        background rgba(255,255,255,0.3)
    .date-swiper
      padding: 0
      overflow: hidden
      display: flex
      flex-direction: row
      font-family: "DIN Alternate", sans-serif
      user-select: none
      margin 10px
      border-radius 20px
      *, *::before, *::after
        box-sizing: border-box
        width auto
        height auto
      // important structure
      ul
        padding: 0
        margin: 0
        display: flex
        flex-direction: row
        flex-wrap: wrap
        li
          list-style-type: none
          padding: .2em 0
          flex: 1 0 14.285714286%
          text-align: center
          text-indent 0px
          &:before
            display none
      .carousel
        display: flex
        flex-direction: row
        position: relative
        // important interactions
        &.animate
          transition: transform 300ms ease-out
      .month
        flex: 1 0 100%
        padding: .5em
        position: relative
      .month-name
        font-size: 1.2em
        padding: .5em
      .day-names
        font-size: .8em
        line-height: 1.5
      .days
        font-size: 1em
        line-height: 2
      .date
        padding: 0
        border-radius: 100%
        margin: .3em auto
        width: 2em
        height: 2em
        pointer-events: none
  .button-row
    display flex
    justify-content center
    padding 0.5rem
    background #edebfa
    .done
      height 2em
      line-height 2em
      text-transform uppercase
      border 1px solid #333
      border-radius 1em
      text-align center
      min-width 12em
      box-shadow inset 0 -10px 2px rgba(0,0,0,0.1)
      background #fff
      cursor pointer
// Theme/Design related
.date-swiper
  z-index: 5
  background: $dark
  color: $lighter
  // important interaction
  &:not(.dragging)
    transition: transform 300ms ease-out
  .month
    background: $base
  .month-holder
    display flex
    position relative
    .prev, .next
      width 2em
      height 2em
      border 2px solid #fff
      border-radius 100%
      text-align center
      line-height 1.8em
      cursor pointer
      position absolute
    .next
      right 0
    .month-name
      text-transform: uppercase
      flex 1
      text-align center
    .month-year
      opacity: .65
  .day-names
    text-transform: uppercase
    border-top: .1em solid
    border-bottom: .1em solid
    color: rgba($dark, 0.5)
  .days li
    &:not(.day-in-curr-month)
      opacity: .65
  .is-today .date
    background: rgba($dark, 0.25)
  .is-selected
    .date
      background: $base
      color: $lighter
      box-shadow: 0 0 0 .1em
  .toggle
    background: rgba($dark, 0.25)
    color: $light
@media screen and (max-width: 400px)
  .date-swiper-holder
    transform: translate3d(-200%, 0%, 0)

.date-swiper-holder.appointment-date-picker
  background rgba(0,0,0,0.45)
  font-family inherit
  .date-swiper-box
    display flex
    width 540px
    max-width calc(100vw - 32px)
    max-height calc(100vh - 32px)
    overflow-y auto
    border-radius 20px
    background white
    box-shadow 0 16px 48px rgba(0,0,0,0.25)
  .selected-date
    flex 0 0 150px
    background vs-orange
    color white
    text-align center
    padding-bottom 30px
    .selected-weekday
      padding 15px 10px
      background rgba(0,0,0,0.08)
      font-size 1.8rem
      font-weight 600
    .selected-day
      font-size 8rem
      line-height 1.2
      padding 24px 0 12px
      font-weight 600
    .selected-month, .selected-year
      font-size 2.4rem
      line-height 1.2
  .calendar-panel
    flex 1
    min-width 0
    padding 16px
  button
    font-family inherit
    border 0
    margin 0
    padding 0
    box-shadow none
    cursor pointer
    &:focus-visible
      outline 2px solid vs-orange
      outline-offset 2px
  .date-swiper
    margin 0
    border-radius 0
    background white
    color vs-text
    font-family inherit
    .carousel
      width 100%
    .month
      background white
      padding 0
      font-size 1.4rem
    .month-holder
      align-items center
      height 44px
      .month-name
        text-transform none
        font-size 1.8rem
        font-weight 600
        padding 0 40px
      .month-year
        opacity 1
      .prev, .next
        border 0
        background transparent
        color vs-grey
        font-size 2.4rem
        width 36px
        height 36px
        line-height 36px
        top 4px
        &:hover
          background vs-body
    .day-names
      border 0
      background white
      color #777
      font-size 1.2rem
      padding 10px 0
    .days li
      padding 2px 0
      &:not(.day-in-curr-month)
        opacity 0.4
      .date
        display block
        pointer-events auto
        width 36px
        height 36px
        line-height 36px
        margin 0 auto
        font-size 1.4rem
        background transparent
        color vs-text
        &:hover
          background #fff0e8
      &.is-today .date
        box-shadow inset 0 0 0 1px vs-orange
      &.is-selected .date
        background vs-orange
        color white
        box-shadow none
  .button-row
    justify-content flex-end
    gap 8px
    background white
    padding 12px 0 0
    button
      display inline-flex
      align-items center
      justify-content center
      text-align center
      min-width 60px
      height 36px
      line-height 1
      padding 0 12px
      border 0
      border-radius 8px
      background white
      color vs-grey
      font-size 1.4rem
      font-weight 600
      box-shadow none
      text-transform none
      &:hover
        background vs-body
      &.done
        background vs-orange
        color white
        &:hover
          background darken(vs-orange, 8%)
  @media screen and (max-width: 520px)
    .date-swiper-box
      flex-direction column
      width 360px
    .selected-date
      flex auto
      display flex
      align-items baseline
      justify-content center
      gap 8px
      padding 14px
      .selected-weekday
        background none
        padding 0
        font-size 1.4rem
      .selected-day
        padding 0
        font-size 3rem
      .selected-month, .selected-year
        font-size 1.8rem