.setup
  padding-top 30px
  .setup-row
    margin-bottom 30px
  .email-templates, .sms-templates, .setup-row
    .button
      margin-top 10px
  .email-template, .sms-template, .dashboard-item
    display flex
    align-items center
    background vs-white
    margin 0.5rem 0
    padding 0.8rem
    border-radius 8px
    .name
      flex 1
    a
      color inherit
      &:hover
        color vs-orange
    
  .progressions-controls
    display flex
    justify-content space-between
  .progression-layout-setup
    margin-bottom 30px
    padding 20px
    background white
    border-radius 20px
    fieldset
      min-width 180px
    legend
      font-size 1.6rem
      font-weight 600
    label
      display block
      small
        display block
        font-weight 400
    select
      width 100%
      margin-bottom 15px
.template
  padding-top 30px
@media screen and (max-width:576px)
  .setup
    .sms-templates,
    .income
      margin-top 30px